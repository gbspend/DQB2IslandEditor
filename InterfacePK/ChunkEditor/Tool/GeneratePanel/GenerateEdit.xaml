<UserControl x:Class="DQB2IslandEditor.InterfacePK.ChunkEditor.Tool.GeneratePanel.GenerateEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="500">
    <UserControl.Resources>
        <Style TargetType="Button" x:Key="GenerateButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" Background="#2E7D32" CornerRadius="8" Padding="24,6">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#43A047" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1B5E20" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- Fixed width like the Block Edit panel; the Viewbox scales it to the panel's width. -->
    <Viewbox>
        <Border Background="Black" BorderBrush="LimeGreen" BorderThickness="1.5" CornerRadius="5" Margin="0,12,0,0" Width="480" Padding="14,10">
            <StackPanel>
                <TextBlock Name="HintText" Foreground="LightGray" FontSize="13" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <!-- Everything below is disabled until there's a painted selection. -->
                <StackPanel Name="ParameterPanel" IsEnabled="{Binding HasGenerateSelection}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!-- Mountain parameters: label, slider, value. -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                            <Style TargetType="Slider">
                                <Setter Property="TickFrequency" Value="1"/>
                                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                                <Setter Property="SmallChange" Value="1"/>
                                <Setter Property="LargeChange" Value="5"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Text="Max layer:" ToolTip="Height of the main plateau."/>
                        <Slider Grid.Row="0" Grid.Column="1" Name="MaxLayerSlider" Minimum="5" Maximum="95" Value="60" ValueChanged="MaxLayerChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Value, ElementName=MaxLayerSlider}"/>
                        <!-- Shown when existing ground pokes out above the mountain. -->
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Name="MaxLayerWarning" Foreground="#FF5252" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>

                        <TextBlock Grid.Row="2" Text="Base coverage:" ToolTip="How much of the selection the mountain's base spreads over."/>
                        <Slider Grid.Row="2" Grid.Column="1" Name="CoverageSlider" Minimum="50" Maximum="100" Value="90"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=CoverageSlider, StringFormat={}{0}%}"/>

                        <TextBlock Grid.Row="3" Text="Plateau size:" ToolTip="How wide the flat tops are. Bigger plateaus mean steeper slopes."/>
                        <Slider Grid.Row="3" Grid.Column="1" Name="PlateauSlider" Minimum="5" Maximum="70" Value="30"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Value, ElementName=PlateauSlider, StringFormat={}{0}%}"/>

                        <TextBlock Grid.Row="4" Text="Roughness:" ToolTip="How lumpy the outline and slopes are. 0% is perfectly smooth."/>
                        <Slider Grid.Row="4" Grid.Column="1" Name="RoughnessSlider" Minimum="0" Maximum="100" Value="50"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Value, ElementName=RoughnessSlider, StringFormat={}{0}%}"/>

                        <CheckBox Grid.Row="5" Name="SecondPlateauCheck" IsChecked="True" VerticalAlignment="Center"
                                  VerticalContentAlignment="Center" ToolTip="Add a lower second plateau beside the main one. Its height is a percentage of the main one's.">
                            <TextBlock Text="2nd plateau:"/>
                        </CheckBox>
                        <Slider Grid.Row="5" Grid.Column="1" Name="SecondHeightSlider" Minimum="20" Maximum="90" Value="60"
                                IsEnabled="{Binding IsChecked, ElementName=SecondPlateauCheck}"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Value, ElementName=SecondHeightSlider, StringFormat={}{0}%}"
                                   Opacity="{Binding Opacity, ElementName=SecondHeightSlider}"/>

                        <TextBlock Grid.Row="6" Text="Seed:" ToolTip="Same seed and settings make the same mountain."/>
                        <TextBox Grid.Row="6" Grid.Column="1" Name="SeedBox" FontSize="14" VerticalAlignment="Center" Padding="2,1"
                                 PreviewTextInput="SeedTextInput"/>
                        <Button Grid.Row="6" Grid.Column="2" Content="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Margin="6,4,0,4" ToolTip="New random seed" Click="RandomSeedClick"/>
                    </Grid>
                    <Button Name="GenerateButton" Content="Generate" Style="{StaticResource GenerateButton}" HorizontalAlignment="Center"
                            Click="GenerateClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Viewbox>
</UserControl>
